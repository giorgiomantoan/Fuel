<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- MIMIT potrebbe usare HTTP reindirizzato -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">mimit.gov.it</domain>
    </domain-config>
    <!-- Tile server osmdroid (Thunderforest) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tile.thunderforest.com</domain>
    </domain-config>
</network-security-config>
